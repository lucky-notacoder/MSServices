{
  "cleanUrls": false,
  "trailingSlash": false,
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/$", "dest": "/index.html" },
    { "src": "^/home/?$", "dest": "/index.html" },
    { "src": "^/index(?:\\.html)?/?$", "dest": "/index.html" },
    { "src": "^/services(?:\\.html)?/?$", "dest": "/services.html" },
    { "src": "^/blog(?:\\.html)?/?$", "dest": "/Blog.html" },
    { "src": "^/Blog\\.html$", "dest": "/Blog.html" },
    { "src": "^/blog-detail(?:\\.html)?/?$", "dest": "/blog-detail.html" },
    { "src": "^/service-detail(?:\\.html)?/?$", "dest": "/service-detail.html" },
    { "src": "^/cma-study(?:\\.html)?/?$", "dest": "/cma-study.html" },
    { "src": "^/contact(?:\\.html)?/?$", "dest": "/contact.html" }
  ]
}
